---
import BaseLayout from '../components/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
const faqs = [
  { q: "What types of financial institutions do you work with?", a: "We work with growth-stage financial institutions including mid-market PE firms, regional banks, fund administrators, and licensed corporations across Hong Kong, Singapore, and London." },
  { q: "How long does a typical engagement take?", a: "Most projects run 8-16 weeks from discovery to production deployment." },
  { q: "Do you work with existing technology stacks?", a: "Yes. We audit your current systems and design solutions that integrate with what you already have." },
  { q: "What about data security and compliance?", a: "Every system we build includes audit trails, PII redaction, RBAC, and compliance controls as first-class features." },
  { q: "Can you support systems after launch?", a: "Yes. We offer ongoing support and iteration contracts." },
  { q: "What technologies do you use?", a: "Python (LangGraph, LangChain, FastAPI), TypeScript (Next.js, Astro), ChromaDB, DeepSeek API, and cloud platforms." },
];
const schema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<BaseLayout title="Support & FAQ — Jonathan Simpson & Co." description="Frequently asked questions.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <section class="section page-content">
    <div class="container">
      <SectionIntro eyebrow="Support" title="Frequently asked questions" />
      <div style="max-width:45rem">
        {faqs.map(f => (
          <details style="border-bottom:1px solid var(--color-line);padding:1.25rem 0">
            <summary style="font-weight:500;cursor:pointer;color:var(--color-ink);list-style:none;display:flex;justify-content:space-between;align-items:center">
              {f.q}<span style="color:var(--color-accent);font-size:1.25rem">+</span>
            </summary>
            <p style="margin-top:1rem;color:var(--color-muted)">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  document.querySelectorAll('details').forEach(d => d.addEventListener('toggle', () => {
    const icon = d.querySelector('summary span');
    if (icon) icon.textContent = d.open ? '−' : '+';
  }));
</script>
