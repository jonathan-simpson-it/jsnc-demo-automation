---
import BaseLayout from '../../components/BaseLayout.astro';
import ChipList from '../../components/ChipList.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const schema = { "@context": "https://schema.org", "@type": "Article", headline: project.data.title, description: project.data.description, datePublished: project.data.pubDate.toISOString() };
---
<BaseLayout title={`${project.data.title} — Jonathan Simpson & Co.`} description={project.data.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <article class="section page-content">
    <div class="container">
      <div class="prose">
        <a href="/work/" style="font-size:var(--text-small);text-transform:uppercase;letter-spacing:0.06em;color:var(--color-accent)">← Back to work</a>
        <header style="margin:2rem 0 3rem">
          <span class="section-eyebrow">{project.data.client}</span>
          <h1>{project.data.title}</h1>
          <p style="color:var(--color-muted);margin-top:0.5rem">{project.data.description}</p>
          {project.data.tags.length > 0 && <div style="margin-top:1rem"><ChipList tags={project.data.tags} /></div>}
        </header>
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
